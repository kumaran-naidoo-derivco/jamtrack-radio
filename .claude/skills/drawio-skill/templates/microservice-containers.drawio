        </mxCell>
        <mxCell id="e-gw-svc-b" value="gRPC / HTTP" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="apigw" target="svc-b">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-gw-svc-c" value="gRPC / HTTP" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.75;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="apigw" target="svc-c">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>

        <!-- Service B → Message Bus (publish)
             exitY=0.35 fans out from svc-b right face (svc-b→db-b uses 0.65 below).
             Label offset y=-14 lifts label above the line, clearing any shape underneath. -->
        <mxCell id="e-svcb-bus" value="publish" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.35;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="svc-b" target="msgbus">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>

        <!-- Message Bus → Service C (subscribe)
             exitY=0.65 on msgbus left face (clear of any other edge on that face).
             entryY=0.65 on svc-c right face (avoids the entryY=0.5 used by gateway). -->
        <mxCell id="e-bus-svcc" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.65;entryX=1;entryY=0.65;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="msgbus" target="svc-c">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>

        <!-- Services → Databases
             svc-b: exitY=0.65 fans out on right face (exitY=0.35 is the bus edge above). -->
        <mxCell id="e-svca-dba" value="SQL (Dapper)" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="svc-a" target="db-a">
