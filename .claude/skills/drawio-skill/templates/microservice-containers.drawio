        <!-- ─── RELATIONSHIPS ──────────────────────────────────────── -->

        <!-- User → Gateway -->
        <mxCell id="e-user-gw" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1" source="actor-user" target="apigw">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>

        <!-- Gateway → Services (fanned out — 3 edges on right face: exitY=0.25/0.5/0.75) -->
        <mxCell id="e-gw-svc-a" value="gRPC / HTTP" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.25;entryX=0;entryY=0.5;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=none;" edge="1" parent="system-boundary" source="apigw" target="svc-a">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
